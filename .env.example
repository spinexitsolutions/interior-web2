# Required in production: a long random string used to sign admin sessions.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# First-run admin login (used until you set a new one in Admin → Settings → Account)
ADMIN_EMAIL=admin@aangan.studio
ADMIN_PASSWORD=admin123

# Where the CMS stores db.json and uploads (defaults to ./data). Point at a persistent volume in production.
# DATA_DIR=/var/lib/aangan
